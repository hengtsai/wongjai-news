### Step 4: 一次性批次翻譯 ⭐ 重點 ⭐
將所有文章打包成以下 JSON，**一次**發送翻譯請求：

**用這個工具翻譯**:
```python
python3 << 'PYEOF'
from deep_translator import GoogleTranslator
import json, sys

batch = json.load(sys.stdin)  # list of {id, title, summary}

t_zh = GoogleTranslator(source='auto', target='zh-TW')
t_cn = GoogleTranslator(source='auto', target='zh-CN')
t_ja = GoogleTranslator(source='auto', target='ja')

def ts(t, text):
    try: return t.translate(text[:2000])
    except: return text

results = []
for item in batch:
    title = item["title"]
    summary = item["summary"]
    results.append({
        "id": item["id"],
        "title_zh_tw": ts(t_zh, title).replace('"', "'"),
        "title_zh_cn": ts(t_cn, title).replace('"', "'"),
        "title_ja": ts(t_ja, title).replace('"', "'"),
        "summary_zh_tw": ts(t_zh, summary).replace('"', "'"),
        "summary_zh_cn": ts(t_cn, summary).replace('"', "'"),
        "summary_ja": ts(t_ja, summary).replace('"', "'"),
    })

print(json.dumps(results, ensure_ascii=False, indent=2))
PYEOF
```

